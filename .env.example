# Demo requests -> a private Google Sheet.
#
# Copy to .env.local and fill in. See README.md for how to create the service
# account, which sheet to share it with, and where each value comes from.
#
# NONE of these may be renamed to NEXT_PUBLIC_*: that prefix inlines the value
# into the JavaScript sent to the browser, which would publish the private key
# to every visitor. They are read only on the server.
#
# Never commit a filled-in copy. .env.local is gitignored.

# The long id in the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# "client_email" from the service account's JSON key. This address must be
# shared on the sheet with Editor access, or every append returns 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# "private_key" from the same JSON key, quoted, with newlines left as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional. The tab the rows are appended to. Defaults to "Demo Requests".
# GOOGLE_SHEETS_SHEET_NAME="Demo Requests"
