# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# Google service-account keys. The JSON file downloaded from the Cloud Console
# is a live credential; its two useful values belong in the environment, not in
# the repo. See README.md.
service-account*.json
*-service-account.json
gcp-key*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Intermediate full-screen product captures. The thirteen files the site
# ships are derived from these into public/images/product/ by
# scripts/crop-product-screenshots.mjs; the originals are large and reproducible.
capture/
